# Copy this file to .env and fill in real values by hand — never commit .env.
# Per security.md: no agent ever writes a real secret into this or any file.

# Database (Supabase Postgres) — see database-schema.md
DATABASE_URL=
DIRECT_URL=

# NextAuth.js v5 — admin authentication only, see security.md
NEXTAUTH_URL=
NEXTAUTH_SECRET=

# Admin account, used only by prisma/seed.ts (Open Question 2: seed-script
# approach) to create/update the single admin User with a bcrypt-hashed
# password. Never read anywhere else.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# AI — not used until Phase 2/3, listed here for completeness per AGENTS.md Section 5
OPENAI_API_KEY=

# Rate limiting — not used until Phase 2/3
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# System prompt cache — not used until Phase 2/3
KV_REST_API_URL=
KV_REST_API_TOKEN=

# File storage — used by Phase 1 admin screenshot upload
BLOB_READ_WRITE_TOKEN=

# Transactional email — used if the Contact form's Resend notification is enabled
RESEND_API_KEY=

# Public app URL
NEXT_PUBLIC_APP_URL=
